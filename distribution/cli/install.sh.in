#!/usr/bin/env bash
# Released bootstrap: download this build's verified cloudctl, reuse its installer.
set -Eeuo pipefail

@@HOST_CHECKS@@

fail() { printf '[cloud] %s\n' "$*" >&2; return 1; }
usage() {
    cat <<'HELP'
Usage: install.sh [--channel dev|stable] [--run-id ID | --version X.Y.Z]
Install the independent cloudctl and ensure the platform is installed.
--cli-only installs cloudctl without a platform. Automation defaults off.
Uses the existing cloudctl installer, task worker and verification.
Same build is skipped; a new dev build uses the protected upgrade path.
HELP
}
prepare_dependencies() {
    if ! command -v curl >/dev/null || ! command -v python3 >/dev/null ||
       [[ ! -s /etc/ssl/certs/ca-certificates.crt ]]; then
        export DEBIAN_FRONTEND=noninteractive
        apt-get update
        apt-get install -y --no-install-recommends curl ca-certificates python3
    fi
}
main() {
    local channel='@@DEFAULT_CHANNEL@@' run_id='' version='' work='' cli_only=0
    while (( $# )); do
        case "$1" in
            --cli-only) cli_only=1; shift ;;
            --help|-h) usage; return 0 ;;
            --channel|--run-id|--version)
                (( $# >= 2 )) || { fail "Missing value for $1"; return 2; }
                case "$1" in
                    --channel) channel=$2 ;;
                    --run-id) run_id=$2 ;;
                    --version) version=$2 ;;
                esac
                shift 2 ;;
            *) fail "Unknown option: $1"; return 2 ;;
        esac
    done
    [[ $channel == dev || $channel == stable ]] || { fail 'Channel must be dev or stable'; return 2; }
    [[ -z $run_id || ( $channel == dev && $run_id =~ ^[1-9][0-9]{0,19}$ ) ]] || { fail '--run-id requires dev and a positive build ID'; return 2; }
    [[ -z $version || ( $channel == stable && $version =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ) ]] || { fail '--version requires stable and X.Y.Z'; return 2; }
    [[ $(id -u) == 0 ]] || { fail 'Run with sudo bash'; return 1; }
    printf '[cloud] 1/4 Checking host and dependencies\n'
    check_supported_os || return 1
    case "$(uname -m)" in x86_64|aarch64) ;; *) fail 'Supported architectures: x86_64 or aarch64'; return 1 ;; esac
    prepare_dependencies
    umask 077
    work=$(mktemp -d)
    # Keep the downloaded CLI until the foreground wait returns; the independent
    # worker runs from cloudctl's immutable bootstrap cache, not this directory.
    # Freeze the safely quoted local path; EXIT runs after main's local scope ends.
    # shellcheck disable=SC2064
    trap "$(printf 'rm -rf -- %q' "$work")" EXIT
    printf '[cloud] 2/4 Downloading and verifying cloudctl\n'
    curl --proto '=https' --proto-redir '=https' --tlsv1.2 --fail --location \
        --retry 3 --connect-timeout 20 --max-time 120 --max-filesize 4194304 \
        -o "$work/cloudctl" '@@CLI_URL@@'
    printf '%s  %s\n' '@@CLI_SHA256@@' "$work/cloudctl" | sha256sum -c - >/dev/null || {
        fail 'cloudctl checksum mismatch; installation was not started'; return 1;
    }
    python3 -I -B "$work/cloudctl" setup
    if (( cli_only )); then printf '[cloud] Independent cloudctl ready. Use sudo cloudctl install --channel dev.\n'; return 0; fi
    local -a args=(install --channel "$channel" --repository '@@REPOSITORY@@')
    [[ -z $run_id ]] || args+=(--run-id "$run_id")
    [[ -z $version ]] || args+=(--version "$version")
    printf '[cloud] 3/4 Installing; downloads may take time. Do not submit twice.\n'
    printf '[cloud] After disconnect: sudo cloudctl update status; sudo cloudctl system-logs install\n'
    python3 -I -B "$work/cloudctl" "${args[@]}" > "$work/result.json" || {
        fail 'Installation did not finish successfully. Inspect status/logs before retrying.'; return 1;
    }
    cat "$work/result.json"
    python3 -I -c 'import json,sys; sys.exit(0 if json.load(open(sys.argv[1]))["phase"] in ("succeeded","unchanged") else 1)' "$work/result.json" || {
        fail 'Requested version was not installed; confirm it using cloudctl install with --yes if required.'; return 1;
    }
    printf '[cloud] 4/4 Verifying installed services and local policy\n'
    python3 -I -B "$work/cloudctl" status
    python3 -I -B "$work/cloudctl" version
    printf '[cloud] Installation verified. Local automation policy was preserved (default OFF).\n'
    printf '[cloud] Web: http://127.0.0.1:8088/ on this server; use your secured access path.\n'
    printf '[cloud] Login token stays private; view locally with sudo cloudctl token.\n'
}

# Call only after Bash has parsed the complete main function, including piped downloads.
main "$@"
