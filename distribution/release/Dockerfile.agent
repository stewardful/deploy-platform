# syntax=docker/dockerfile:1
FROM rust:1.96-slim-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends build-essential ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /src
ARG TARGETARCH
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY apps/agent ./apps/agent
COPY examples ./examples
# Separate targets by architecture; copy outputs while the build cache is mounted.
RUN --mount=type=cache,id=cloud-agent-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=cloud-agent-target-${TARGETARCH},target=/src/target,sharing=locked \
    cargo build --release --locked -j 1 -p node-agent --bins && \
    mkdir -p /output/bin && cp target/release/agentd target/release/agentctl /output/bin/
FROM scratch
COPY --from=build /output /output
