[Unit]
Description=Deploy Platform explicit stable/dev platform upgrade
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/local/bin/cloudctl worker
Environment=PYTHONDONTWRITEBYTECODE=1
# Must outlive control/agent/proxy restarts; keep installer in its own cgroup.
TimeoutStartSec=infinity
KillMode=control-group
Nice=10
CPUWeight=20
MemoryHigh=192M
