#!/usr/bin/env bash
# Self-contained installer. Verify the .sha256 file from a trusted source before running.
set -Eeuo pipefail
umask 077
@OS_POLICY@
export PYTHONDONTWRITEBYTECODE=1
if [[ ${1:-} == --help ]]; then
    printf '%s\n' 'Usage: sudo bash deploy-platform-VERSION-linux-ARCH.run [--skip-apt] [--upgrade] [--bridge-cidr CIDR] [--smoke-test] [--drain-seconds 300] [--verify-seconds 120] [--checks-file /ABS/PATH]' '       bash deploy-platform-VERSION-linux-ARCH.run --check' 'No application builds run on the target node. --check only verifies the payload.'
    exit 0
fi
work=$(mktemp -d "${TMPDIR:-/var/tmp}/cloud-bootstrap.XXXXXXXX")
trap 'rm -rf -- "$work"' EXIT
line=$(awk '/^__CLOUD_ARCHIVE__$/{print NR+1; exit}' "$0")
[[ $line =~ ^[0-9]+$ ]] || { echo 'installer payload missing' >&2; exit 1; }
tail -n "+$line" "$0" > "$work/payload.tar.gz"
if command -v sha256sum >/dev/null; then actual=$(sha256sum "$work/payload.tar.gz" | cut -d ' ' -f 1); else actual=$(shasum -a 256 "$work/payload.tar.gz" | cut -d ' ' -f 1); fi
[[ $actual == '@PAYLOAD_SHA256@' ]] || { echo 'installer payload checksum mismatch' >&2; exit 1; }
if ! command -v python3 >/dev/null; then
    [[ ${1:-} != --check && $(id -u) == 0 && $(uname -s) == Linux ]] || { echo 'python3 is needed to verify/extract the payload' >&2; exit 1; }
    for option in "$@"; do [[ $option != --skip-apt ]] || { echo "--skip-apt requires python3 already installed" >&2; exit 1; }; done
    check_supported_os || exit 1
    DEBIAN_FRONTEND=noninteractive apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends python3
fi
cat > "$work/archive.py" <<'CLOUD_ARCHIVE_PY'
@ARCHIVE_HELPER@
CLOUD_ARCHIVE_PY
mkdir "$work/payload"
python3 "$work/archive.py" extract "$work/payload.tar.gz" --destination "$work/payload"
python3 "$work/archive.py" verify "$work/payload" >/dev/null
if [[ ${1:-} == --check ]]; then echo 'PASS: payload and every release file verified'; exit 0; fi
bash "$work/payload/install.sh" --source "$work/payload" "$@"
exit 0
# shellcheck disable=SC2317
__CLOUD_ARCHIVE__
