#!/usr/bin/env bash
# Thin installed-node entry point. Agent operations always use the same agentctl/API.
set -Eeuo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PYTHONDONTWRITEBYTECODE=1
ROOT=/opt/deploy-platform/current
agent() {
    exec "$ROOT/bin/agentctl" --socket /run/deploy-platform/agent.sock "$@"
}
usage() {
    cat <<'HELP'
cloudctl — manage applications on this node

Applications (same Agent API, Go/Web not required):
  apps | list                           List saved applications
  apply | deploy -f app.toml|app.json    Deploy and wait for the task result
  start | stop --project P --name APP    Save desired state and start/stop
  logs --project P --name APP [--tail N] Read application logs (default 100)
  diagnostics --project P --name APP    Inspect runtime and HTTP readiness
  job ID | operations                   Query durable tasks/history

Data and domains:
  secret-create --project P --name KEY --file PRIVATE_FILE
  secrets --project P
  volumes --project P --name APP
  routes | route-set --file route.json | route-delete ...

Node and troubleshooting:
  status | verify                       Check all installed services and API
  doctor                                Check Agent API/worker only
  maintenance [status|enter|exit]        Node-local upgrade admission gate
  version | --version                   Print the installed Agent CLI version
  system-logs [agent|control|runtime|proxy]
  token                                 Print private Web login token (sudo)
  validate | plan -f FILE                Check/preview TOML or JSON offline
  smoke | stateful-smoke | fullstack-smoke --image IMAGE
                                        Opt-in real tests; may restart Agent
  runtime ...                           Administrator nerdctl access
  agentctl ...                          Explicit Agent command forwarding

Use cloudctl help COMMAND for Agent command options.
Examples: cloudctl help deploy; cloudctl help route-set
Default socket: /run/deploy-platform/agent.sock
Run node management commands with sudo. No automatic deployment or cleanup.
HELP
}
system_logs() {
    if [[ $# == 1 && $1 == --help ]]; then usage; exit 0; fi
    [[ $# -le 1 ]] || { echo 'system-logs: one service name expected' >&2; exit 2; }
    local unit
    case ${1:-agent} in
        agent) unit=deploy-agent;; control) unit=deploy-control;;
        runtime) unit=deploy-containerd;; proxy) unit=deploy-proxy;;
        *) echo 'system-logs: agent|control|runtime|proxy' >&2; exit 2;;
    esac
    exec journalctl -u "$unit.service" -n 100 --no-pager
}
# Do not silently ignore flags on commands that can change/test the node.
case ${1:-help} in
    status|verify|token|smoke|stateful-smoke)
        if [[ $# != 1 ]]; then
            if [[ $# == 2 && $2 == --help ]]; then usage; exit 0; fi
            echo "$1 takes no arguments; use cloudctl help" >&2
            exit 2
        fi;;
esac
case ${1:-help} in
    help|-h|--help)
        if [[ $# -le 1 ]]; then usage; else
            shift
            case $1 in
                status|verify|token|version|system-logs|runtime|smoke|stateful-smoke|fullstack-smoke) usage;;
                *) agent help "$@";;
            esac
        fi;;
    token) [[ $(id -u) == 0 ]] || { echo 'sudo is required' >&2; exit 1; }; cat /etc/deploy-platform/control.token;;
    status|verify) exec python3 "$ROOT/smoke.py" health;;
    fullstack-smoke) shift; exec python3 "$ROOT/fullstack_smoke.py" "$@";;
    stateful-smoke) exec python3 "$ROOT/stateful_smoke.py";;
    smoke) exec python3 "$ROOT/smoke.py" project;;
    agentctl) shift; agent "$@";;
    version|--version|-V) agent --version;;
    runtime) shift; exec /opt/deploy-platform/nerdctl "$@";;
    system-logs) shift; system_logs "$@";;
    logs)
        shift
        # Preserve the old system-log spelling while making app logs directly usable.
        case ${1:-agent} in
            agent|control|runtime|proxy) system_logs "$@";;
            *) agent logs "$@";;
        esac;;
    apps|list|apply|deploy|start|stop|diagnostics|job|operations|doctor|maintenance|routes|route-set|route-delete|secret-create|secrets|volumes|validate|plan)
        agent "$@";;
    *) echo "unknown command: $1; use cloudctl help" >&2; exit 2;;
esac
