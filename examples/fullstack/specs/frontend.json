{
  "schema_version": 1,
  "network": "project",
  "ports": [
    {
      "host": 18080,
      "container": 8080
    }
  ],
  "pull_policy": "always",
  "app": {
    "project": "fullstack",
    "name": "frontend"
  },
  "image": "REGISTRY/PROJECT/fullstack:v1",
  "resources": {
    "memory_mib": 64,
    "cpu_millis": 500,
    "pids": 128
  },
  "user": {
    "uid": 65532,
    "gid": 65532
  },
  "environment": {
    "ROLE": "frontend",
    "GOMEMLIMIT": "24MiB",
    "GOMAXPROCS": "1"
  },
  "health_check": {
    "port": 8080,
    "path": "/health"
  }
}
