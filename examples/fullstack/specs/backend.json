{
  "schema_version": 1,
  "network": "project",
  "ports": [],
  "pull_policy": "always",
  "app": {
    "project": "fullstack",
    "name": "backend"
  },
  "image": "REGISTRY/PROJECT/fullstack:v1",
  "resources": {
    "memory_mib": 128,
    "cpu_millis": 500,
    "pids": 128
  },
  "user": {
    "uid": 65532,
    "gid": 65532
  },
  "secrets": [
    {
      "name": "db-password"
    },
    {
      "name": "redis-password"
    }
  ],
  "environment": {
    "ROLE": "backend",
    "GOMEMLIMIT": "48MiB",
    "GOMAXPROCS": "1"
  },
  "health_check": {
    "port": 8080,
    "path": "/health"
  }
}
